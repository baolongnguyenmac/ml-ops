    "version": "0.2.0",
    "configurations": [
        {
            "name": "produce data",
            "type": "debugpy",
            "request": "launch",
            "module": "utils.produce_data",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            // "cwd": "${workspaceFolder}"
        },
        {
            "name": "ingest bronze",
            "type": "debugpy",
            "request": "launch",
            "module": "bronze.ingest_bronze",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": ["--mode", "stream"]
        },
        {
            "name": "ingest silver",
            "type": "debugpy",
            "request": "launch",
            "module": "silver.ingest_silver",
            "env": {
                "PYTHONPATH": "./src"
            },
            "args": ["--mode", "stream"]

        },
        {
            "name": "ingest gold staging",
            "type": "debugpy",
            "request": "launch",
            "module": "gold.ingest_staging",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
        },
        {
            "name": "ingest gold stream",
            "type": "debugpy",
            "request": "launch",
            "module": "gold.ingest_stream",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
        },
    ]
}